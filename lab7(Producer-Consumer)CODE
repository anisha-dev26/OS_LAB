#include <stdio.h>
#include <stdlib.h>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>

#define BUFFER_SIZE 3

int buffer[BUFFER_SIZE];
int in = 0, out = 0;

sem_t empty;
sem_t full;
pthread_mutex_t mutex;

void produce_item(int item) {
    sem_wait(&empty);
    pthread_mutex_lock(&mutex);

    buffer[in] = item;
    printf("Produced: %d at buffer[%d]\n", item, in);
    in = (in + 1) % BUFFER_SIZE;

    pthread_mutex_unlock(&mutex);
    sem_post(&full);
}

void consume_item() {
    int item;
    sem_wait(&full);
    pthread_mutex_lock(&mutex);

    item = buffer[out];
    printf("Consumed: %d from buffer[%d]\n", item, out);
    out = (out + 1) % BUFFER_SIZE;

    pthread_mutex_unlock(&mutex);
    sem_post(&empty);
}

int main() {
  
    sem_init(&empty, 0, BUFFER_SIZE);
    sem_init(&full, 0, 0);
    pthread_mutex_init(&mutex, NULL);

    
    produce_item(0);
    sleep(1);

    produce_item(1);
    sleep(1);

    produce_item(2);
    sleep(1);

    consume_item();
    sleep(1);

    produce_item(3);
    sleep(1);


    // Cleanup
    sem_destroy(&empty);
    sem_destroy(&full);
    pthread_mutex_destroy(&mutex);

    return 0;
}
